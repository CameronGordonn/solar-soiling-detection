# Copy to .env and fill in before running docker-compose.
#
# API auth — set to any secret string to protect the FastAPI endpoints.
# Leave blank to disable auth (local dev only).
SOLARSOILED_API_KEY=

# Per-partner key registry — path to a YAML file mapping API keys to partner_ids.
# When set, each key can only read/write its own partner's data.
# When unset, falls back to single-key mode (SOLARSOILED_API_KEY above).
# See keys.example.yaml for the file format.
SOLARSOILED_KEYS_FILE=

# NASA Earthdata token — enables MERRA-2 PM2.5/PM10 backfill (1980-present).
# Without it, AQ features use CAMS (2022-present only).
# Register at https://urs.earthdata.nasa.gov
NASA_EARTHDATA_TOKEN=

# Open-Meteo commercial API key. The free tier enforces sliding minute/hour/day
# windows, and a bulk AOI or permit-home run WILL exhaust them mid-flight: every
# array then fails its weather fetch and the run stops with 0 feature rows.
#
# IMPORTANT: buying a subscription is not enough on its own. A paid plan does not
# raise the limit on the free hosts — it issues a key for a dedicated
# `customer-*` endpoint. Setting this variable is what moves the client there
# (src/risk/weather_client.py); leaving it blank keeps you on the free hosts and
# their limits no matter what you have paid for. Setting it also drops the
# proactive request pacing, which exists only to stay under the free window.
#
# Plans: Standard $29/mo (1M calls), Professional $99/mo (5M). https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# Lob.com print-and-mail API key (for scripts/22_mail_via_lob.py).
# Get a test key at https://lob.com — test keys start with "test_".
# Leave blank to skip mail submission (script will dry-run only).
LOB_API_KEY=

# Return address for outreach mailers (used by scripts/22_mail_via_lob.py).
# Format: "Name|Line1|City|State|Zip"
SOLARSOILED_RETURN_ADDRESS=
